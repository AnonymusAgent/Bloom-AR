# Required
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# App / domains
NEXT_PUBLIC_APP_URL=https://your-app-domain.example
NEXT_PUBLIC_ROOT_DOMAIN=your-app-domain.example
# Email (required for verification / reset / invites to actually send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BloomAR Manager <noreply@example.com>"
# Platform admin (one of these grants /admin/platform access; set privately in hosting env, never commit real values)
# Comma-separated allowlist — matching sign-ins are auto-promoted to users.is_platform_admin
PLATFORM_ADMIN_EMAILS=
# Bootstrap script only (scripts/bootstrap-platform-admin.mjs): creates/promotes one admin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_TEMP_PASSWORD=
PLATFORM_ADMIN_FIRST_NAME=
PLATFORM_ADMIN_LAST_NAME=
# Payments (optional until checkout is enabled; never put card data in the DB)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hosting domain provisioning (optional, for custom-domain automation status)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
